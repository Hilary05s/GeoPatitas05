{
  "compilerOptions": {
    // Estructura: código en src/, compilado (pnpm build) en dist/
    "rootDir": "./src",
    "outDir": "./dist",

    // Node.js con módulos ES (los imports locales terminan en .js)
    "module": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "sourceMap": true,

    // Revisión estricta
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
