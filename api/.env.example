# =========================================================
# GeoPatitas API — variables de entorno
# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube a git. Aquí no van valores secretos reales.
# =========================================================

# --- Servidor ---
# development | production
NODE_ENV=development
PORT=3000

# --- Base de datos (MySQL / MariaDB de XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geopatitas

# --- CORS ---
# Orígenes (frontend) que pueden llamar a la API, separados por coma.
# Ej. producción: CORS_ORIGIN=https://geopatitas.vercel.app
CORS_ORIGIN=http://localhost:5173

# Número de proxies delante de la API (0 en local; 1 en la mayoría de hostings).
TRUST_PROXY=0

# --- Login de moderadores (JWT) ---
# Cadena larga y aleatoria (mínimo 32 caracteres). Para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión (formato: 30m, 8h, 1d)
JWT_EXPIRES_IN=8h

# --- Anti-spam ---
# Sal secreta para guardar la IP de quien reporta como hash (nunca en claro).
# Genérala igual que JWT_SECRET. Si la cambias, los límites por IP se reinician.
IP_HASH_SALT=
# Máximo de reportes que puede enviar una misma IP en 24 horas.
MAX_REPORTES_POR_IP_DIA=10

# --- Fotos (Cloudinary) ---
# Opcional: sin estas tres variables, los reportes se crean SIN foto.
# Se obtienen en https://console.cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta dentro de Cloudinary donde se guardan las fotos
CLOUDINARY_FOLDER=geopatitas
